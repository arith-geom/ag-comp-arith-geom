<header class="header-main">
  <div class="header-content-wrapper">
    <a class="brand" href="{{ site.baseurl }}/" aria-label="{{ site.title | escape }} — {{ site.university | escape }}" title="{{ site.title | escape }}">
      <div class="brand-title">{{ site.title | escape }}</div>
      <div class="university-name">{{ site.university | escape }}</div>
    </a>
    <nav class="main-nav-desktop">
      <ul>
        {% for item in site.data.navigation %}
          <li {% if page.url == item.url %}class="active"{% endif %}>
            <a href="{{ item.url | relative_url }}">
              <i class="{{ item.icon }}" aria-hidden="true"></i>
              <span>{{ item.title | escape }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
    <button class="nav-toggle" type="button" aria-label="Open navigation" aria-controls="sidebar-navigation" aria-expanded="false">
      <span class="nav-toggle-icon"></span>
    </button>
  </div>
</header>

<div class="sidebar-nav" id="sidebar-navigation" aria-hidden="true">
  <button class="sidebar-close" type="button" aria-label="Close navigation">&times;</button>
  <ul>
    {% for item in site.data.navigation %}
      <li {% if page.url == item.url %}class="active"{% endif %}>
        <a href="{{ item.url | relative_url }}">
          <i class="{{ item.icon }}" aria-hidden="true"></i>
          <span>{{ item.title | escape }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>
<div class="sidebar-overlay"></div>
