<!-- Metadata, OpenGraph and Schema.org -->
{% seo %}

<meta name="robots" content="{{ page.robots | default: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' | escape }}">
<link rel="alternate" hreflang="{{ site.lang | default: 'en' }}" href="{{ page.url | absolute_url }}">
<link rel="alternate" hreflang="x-default" href="{{ page.url | absolute_url }}">

<!-- JSON-LD for Structured Data -->
{% if page.url == '/' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "@id": "{{ site.url }}{{ site.baseurl }}/#organization",
  "name": {{ site.title | jsonify }},
  "url": "{{ site.url }}{{ site.baseurl }}/",
  "logo": {
    "@type": "ImageObject",
    "url": {{ site.logo | absolute_url | jsonify }}
  },
  "sameAs": {{ site.social.links | jsonify }},
  "parentOrganization": {
    "@type": "CollegeOrUniversity",
    "name": {{ site.university | jsonify }},
    "url": "https://www.uni-heidelberg.de/en"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": {{ site.contact.phone | jsonify }},
    "email": {{ site.contact.email | jsonify }},
    "contactType": "scientific support"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ site.contact.street_address | jsonify }},
    "addressLocality": {{ site.contact.address_locality | jsonify }},
    "postalCode": {{ site.contact.postal_code | jsonify }},
    "addressCountry": {{ site.contact.address_country | jsonify }}
  }
}
</script>
{% endif %}

<!-- Vendor CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/7.3.2/mdb.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css">


<!-- Google Fonts - Modern Academic Style (similar to Heidelberg University) -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Source+Sans+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<!-- Code Syntax Highlighting -->
<link
  defer
  rel="stylesheet"
  href="{{ '/assets/css/syntax-highlighting/jekyll-pygments-themes-github.css' | relative_url | bust_file_cache }}"
  media=""
  id="highlight_theme_light"
>

{% if page.toc and page.toc.sidebar %}
  <!-- Sidebar Table of Contents -->
  <link defer href="https://cdn.jsdelivr.net/gh/afeld/bootstrap-toc@v1.0.1/dist/bootstrap-toc.min.css" rel="stylesheet">
{% endif %}

<!-- Styles -->

{% if page.pseudocode %}
  <!-- pseudocode -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.pseudocode.url.css }}"
    crossorigin="anonymous"
  >
{% endif %}

<!-- Stable, crawlable icons for browsers and search results. -->
<link rel="icon" href="{{ '/favicon.ico' | relative_url }}" sizes="16x16 32x32 48x48">
<link rel="icon" href="{{ '/assets/img/favicon.svg' | relative_url }}" type="image/svg+xml">
<link rel="icon" href="{{ '/assets/img/favicon-96x96.png' | relative_url }}" type="image/png" sizes="96x96">
<link rel="apple-touch-icon" href="{{ '/assets/img/apple-touch-icon.png' | relative_url }}" sizes="180x180">
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}">



<script>
  // Expose baseurl for JS so it can build correct paths on GitHub Pages
  window.__BASEURL__ = {{ site.baseurl | jsonify }};
  window.__SITEURL__ = {{ site.url | jsonify }};
  // Helper to prefix site.baseurl to root-relative paths
  window.prefixBase = function(path) {
    if (!path) return path;
    // External URLs stay as-is
    if (/^https?:\/\//.test(path)) return path;
    // Already relative to base? Return as-is
    if (window.__BASEURL__ && path.startsWith(window.__BASEURL__ + '/')) return path;
    // If starts with '/', prefix baseurl; otherwise return unchanged
    if (path.startsWith('/')) return (window.__BASEURL__ || '') + path;
    return path;
  };

  // Enforce HTTPS
  if (window.location.protocol === "http:" && window.location.hostname !== "localhost" && window.location.hostname !== "127.0.0.1") {
    window.location.href = window.location.href.replace("http:", "https:");
  }
</script>

<!-- Theme Color for Mobile Browsers -->
<meta name="theme-color" content="#C22032" id="theme-color-meta">

<!-- Enhanced Meta Tags -->
<meta name="application-name" content="AG Computational Arithmetic Geometry">
<meta name="msapplication-TileColor" content="#C22032">
<meta name="viewport" content="width=device-width, initial-scale=1">

<!-- MathJax for LaTeX support -->
{% assign mathjax_layouts = "member,publication,publication_subpage,teaching_subpage" | split: "," %}
{% if page.mathjax or mathjax_layouts contains page.layout %}
<script>
  window.MathJax = {
    tex: {
      inlineMath: [['$', '$'], ['\\(', '\\)']],
      displayMath: [['$$', '$$'], ['\\[', '\\]']],
      processEscapes: true,
      processEnvironments: true
    },
    options: {
      ignoreHtmlClass: 'tex2jax_ignore',
      processHtmlClass: 'tex2jax_process'
    }
  };
</script>

<script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
<script src="{{ '/assets/js/components/mathjax-setup.js' | relative_url | bust_file_cache }}"></script>
{% endif %}

{% if site.enable_darkmode %}
  <link
    defer
    rel="stylesheet"
    href="{{ '/assets/css/syntax-highlighting/jekyll-pygments-themes-native.css' | relative_url | bust_file_cache }}"
    media="none"
    id="highlight_theme_dark"
  >

{% endif %}

{% if page.tikzjax %}
  <link defer rel="stylesheet" type="text/css" href="https://tikzjax.com/v1/fonts.css">
{% endif %}
